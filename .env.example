# ==============================================================================
# TrustVault — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials to Git.
# ==============================================================================

# --- Public Client Configuration (Safe for browser exposure) ---
# Supabase project URL (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co

# Supabase Anonymous/Public API Key (Subject to Postgres Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# --- Server-Only Configuration (STRICTLY FORBIDDEN IN CLIENT BUNDLE) ---
# NOTE FOR PHASE 1: The service role key is NOT created, NOT used, and NOT loaded in Phase 1.
# It is listed below only as a documented future server-only variable for later phases.
# NEVER prefix this variable with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-unused-in-phase-1
